# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Local MongoDB (e.g. started with `docker compose up -d` from the repo root)
MONGO_URI=mongodb://127.0.0.1:27017/iem_admission
# Or MongoDB Atlas free tier:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iem_admission

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Angular dev server origin allowed by CORS
CLIENT_ORIGIN=http://localhost:4200

# Admin account created by `npm run seed` (public registration can never create admins)
ADMIN_EMAIL=admin@iem.edu
ADMIN_PASSWORD=change-me-admin-password

# Separate database used by `npm test`; its name must end in _test because tests wipe it
MONGO_URI_TEST=mongodb://127.0.0.1:27017/iem_admission_test

# Folder for uploaded documents (relative to backend/). Git-ignored.
UPLOAD_DIR=uploads
